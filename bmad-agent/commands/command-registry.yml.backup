# BMAD Method Command Registry
# Version: 3.0.0 - AI Behavior Focused
# Last Updated: 2025-03-06
# 
# This registry defines commands for AI behavioral optimization in the BMAD Method
# focusing on prompt engineering, example-driven learning, and quality enforcement

registry_metadata:
  version: "3.0.0"
  schema_version: "2.0"
  description: "AI-focused command registry for behavioral prompt engineering"
  behavioral_tracking: true
  example_utilization_tracking: true
  quality_enforcement: strict

# Command Categories (AI Behavior Focused)
categories:
  core:
    description: "Essential AI interaction commands"
    behavioral_focus: "clear communication and help"
  persona:
    description: "Specialized AI persona activation"
    behavioral_focus: "expert domain knowledge application"
  memory:
    description: "Learning and pattern recognition"
    behavioral_focus: "continuous improvement and context"
  quality:
    description: "Quality standards and anti-pattern prevention"
    behavioral_focus: "excellence enforcement and validation"
  workflow:
    description: "Task automation and guidance"
    behavioral_focus: "efficient execution and handoffs"
  consultation:
    description: "Multi-perspective collaboration"
    behavioral_focus: "diverse expertise synthesis"
  advanced:
    description: "Meta-prompting and system optimization"
    behavioral_focus: "prompt generation and effectiveness"

# Core Commands
commands:
  # Help and Information
  help:
    category: core
    description: "Display contextual help with memory-enhanced suggestions"
    aliases: [h, ?, help-me, assist]
    shortcuts:
      "?": "Quick help"
      "??": "Extended help with examples"
    usage: |
      /help [topic] [--examples] [--advanced]
      Examples:
        /help commands     # List all commands
        /help memory      # Memory system help
        /help workflow    # Workflow guidance
        /help personas    # Persona information
    parameters:
      topic:
        type: string
        required: false
        description: "Specific help topic"
        values: [commands, personas, workflow, memory, quality, consultation]
      examples:
        type: boolean
        required: false
        default: false
        description: "Show usage examples"
      advanced:
        type: boolean
        required: false
        default: false
        description: "Show advanced options"
    validation:
      - type: topic_exists
        message: "Unknown help topic. Use /help to see available topics."
    metrics:
      track: [usage_count, topic_frequency, user_patterns]
    implementation: "Core orchestrator help system with memory integration"

  agents:
    category: core
    description: "List available personas with usage statistics and insights"
    permission: basic
    aliases: [personas, list, who, team]
    usage: |
      /agents [--stats] [--recommended] [--details]
      Examples:
        /agents              # Basic persona list
        /agents --stats      # Include usage statistics
        /agents --recommended # Show AI recommendations
    parameters:
      stats:
        type: boolean
        required: false
        default: false
        description: "Include usage statistics"
      recommended:
        type: boolean
        required: false
        default: false
        description: "Show AI-recommended personas for current context"
      details:
        type: boolean
        required: false
        default: false
        description: "Show detailed persona descriptions"
    metrics:
      track: [usage_count, persona_switches, recommendation_accuracy]

  context:
    category: core
    description: "Display rich context with memory insights and suggestions"
    permission: basic
    aliases: [ctx, status, where, state, info]
    usage: |
      /context [--full] [--memory] [--suggestions]
      Examples:
        /context            # Current context summary
        /context --full     # Detailed context information
        /context --memory   # Include memory insights
    parameters:
      full:
        type: boolean
        required: false
        default: false
        description: "Show full context details"
      memory:
        type: boolean
        required: false
        default: true
        description: "Include memory insights"
      suggestions:
        type: boolean
        required: false
        default: true
        description: "Show next step suggestions"
    metrics:
      track: [usage_count, context_depth, suggestion_acceptance]

  # Persona Commands
  analyst:
    category: persona
    description: "Activate Analyst persona (Larry) for research and discovery"
    permission: basic
    aliases: [larry, research, analyze]
    shortcuts:
      "/a": "Quick switch to analyst"
    usage: |
      /analyst [task] [--context]
      Examples:
        /analyst                    # Switch to analyst
        /analyst investigate API    # Start investigation task
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      context:
        type: string
        required: false
        description: "Additional context for the persona"
    validation:
      - type: persona_available
        message: "Analyst persona is currently busy"
    metrics:
      track: [activation_count, task_types, session_duration]
    implementation: "personas/analyst.md"

  pm:
    category: persona
    description: "Activate Product Manager persona (Jack) for strategy and planning"
    permission: basic
    aliases: [jack, product, strategy]
    shortcuts:
      "/p": "Quick switch to PM"
    usage: |
      /pm [task] [--market-analysis]
      Examples:
        /pm                     # Switch to PM
        /pm roadmap Q2         # Start roadmap planning
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      market_analysis:
        type: boolean
        required: false
        default: false
        description: "Include market analysis"
    metrics:
      track: [activation_count, strategy_tasks, roadmap_updates]
    implementation: "personas/pm.md"

  architect:
    category: persona
    description: "Activate Architect persona (Mo) for system design"
    permission: basic
    aliases: [mo, architecture, design]
    shortcuts:
      "/ar": "Quick switch to architect"
    usage: |
      /architect [task] [--patterns]
      Examples:
        /architect                  # Switch to architect
        /architect design auth     # Design authentication
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      patterns:
        type: boolean
        required: false
        default: true
        description: "Apply design patterns"
    metrics:
      track: [activation_count, design_patterns, architecture_decisions]
    implementation: "personas/architect.md"

  dev:
    category: persona
    description: "Activate Developer persona for implementation"
    permission: basic
    aliases: [developer, implement, code]
    shortcuts:
      "/d": "Quick switch to developer"
    usage: |
      /dev [task] [--frontend|--fullstack]
      Examples:
        /dev                    # Switch to developer
        /dev implement STORY-1  # Implement specific story
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      frontend:
        type: boolean
        required: false
        default: false
        description: "Frontend developer (Rodney)"
      fullstack:
        type: boolean
        required: false
        default: true
        description: "Full stack developer (Jonsey)"
    metrics:
      track: [activation_count, implementation_tasks, code_quality]
    implementation: "personas/dev.ide.md"

  sm:
    category: persona
    description: "Activate Scrum Master persona (SallySM) for agile facilitation"
    permission: basic
    aliases: [sallysm, scrum, agile]
    shortcuts:
      "/s": "Quick switch to SM"
    usage: |
      /sm [task] [--ceremony]
      Examples:
        /sm                    # Switch to SM
        /sm sprint-planning    # Start sprint planning
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      ceremony:
        type: string
        required: false
        description: "Specific ceremony to facilitate"
        values: [planning, daily, review, retro]
    metrics:
      track: [activation_count, ceremony_types, team_velocity]
    implementation: "personas/sm.ide.md"

  po:
    category: persona
    description: "Activate Product Owner persona (Curly) for delivery management"
    permission: basic
    aliases: [curly, product-owner, delivery]
    shortcuts:
      "/po": "Quick switch to PO"
    usage: |
      /po [task] [--prioritize]
      Examples:
        /po                    # Switch to PO
        /po validate backlog   # Validate product backlog
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      prioritize:
        type: boolean
        required: false
        default: false
        description: "Run prioritization exercise"
    metrics:
      track: [activation_count, backlog_health, delivery_metrics]
    implementation: "personas/po.md"

  quality:
    category: persona
    description: "Activate Quality Enforcer persona for zero-tolerance quality"
    permission: basic
    aliases: [qe, quality-enforcer, enforce]
    shortcuts:
      "/q": "Quick switch to Quality Enforcer"
    usage: |
      /quality [task] [--strict]
      Examples:
        /quality               # Switch to Quality Enforcer
        /quality audit code    # Audit code quality
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      strict:
        type: boolean
        required: false
        default: true
        description: "Enforce strict quality standards"
    metrics:
      track: [activation_count, violations_found, quality_improvements]
    implementation: "personas/quality_enforcer.md"

  design-architect:
    category: persona
    description: "Activate Design Architect persona (Millie) for UX/UI design"
    permission: basic
    aliases: [millie, ux, ui, design]
    shortcuts:
      "/da": "Quick switch to Design Architect"
    usage: |
      /design-architect [task] [--system]
      Examples:
        /design-architect           # Switch to Design Architect
        /design-architect flow auth # Design auth flow
    parameters:
      task:
        type: string
        required: false
        description: "Optional task to start"
      system:
        type: string
        required: false
        description: "Design system to use"
    metrics:
      track: [activation_count, design_tasks, component_usage]
    implementation: "personas/design-architect.md"

  # Memory Commands
  remember:
    category: memory
    description: "Add information to persistent memory with categorization"
    permission: standard
    aliases: [mem, save, store, memorize]
    usage: |
      /remember {content} [--category] [--tags] [--priority]
      Examples:
        /remember "API key pattern: Bearer token in header" --category=patterns
        /remember "User prefers TypeScript" --tags=preferences,tech
    parameters:
      content:
        type: string
        required: true
        description: "Content to remember"
        max_length: 5000
      category:
        type: string
        required: false
        default: "general"
        description: "Memory category"
        values: [decisions, patterns, mistakes, handoffs, consultations, user-preferences, quality-metrics, udtm-analyses, brotherhood-reviews, general]
      tags:
        type: array
        required: false
        description: "Tags for categorization"
      priority:
        type: string
        required: false
        default: "normal"
        values: [low, normal, high, critical]
    validation:
      - type: content_not_empty
        message: "Content cannot be empty"
      - type: memory_available
        message: "Memory system not available"
    metrics:
      track: [memory_additions, category_distribution, tag_usage]
    implementation: "OpenMemory MCP integration"

  recall:
    category: memory
    description: "Search and retrieve memories with natural language"
    permission: standard
    aliases: [search, find, retrieve, lookup]
    usage: |
      /recall {query} [--category] [--limit] [--since]
      Examples:
        /recall "authentication patterns"
        /recall "user preferences" --category=user-preferences
        /recall "recent decisions" --since="7 days ago"
    parameters:
      query:
        type: string
        required: true
        description: "Natural language search query"
      category:
        type: string
        required: false
        description: "Filter by category"
      limit:
        type: integer
        required: false
        default: 10
        min: 1
        max: 50
        description: "Maximum results to return"
      since:
        type: string
        required: false
        description: "Time filter (e.g., '7 days ago', 'last week')"
    validation:
      - type: query_not_empty
        message: "Search query cannot be empty"
    metrics:
      track: [search_queries, result_relevance, category_filters]
    implementation: "OpenMemory MCP integration"

  insights:
    category: memory
    description: "Get AI-powered insights from memory patterns"
    permission: standard
    aliases: [analyze, patterns, intelligence]
    usage: |
      /insights [--focus] [--depth] [--actionable]
      Examples:
        /insights                        # General insights
        /insights --focus=performance    # Performance insights
        /insights --actionable          # Only actionable insights
    parameters:
      focus:
        type: string
        required: false
        description: "Focus area for insights"
        values: [performance, quality, workflow, team, architecture, all]
      depth:
        type: string
        required: false
        default: "standard"
        values: [quick, standard, deep]
      actionable:
        type: boolean
        required: false
        default: false
        description: "Only show actionable insights"
    metrics:
      track: [insight_generation, focus_areas, actionability_rate]

  patterns:
    category: memory
    description: "Display recognized patterns from memory analysis"
    permission: standard
    aliases: [working-patterns, habits, trends]
    usage: |
      /patterns [--type] [--timeframe] [--visualize]
      Examples:
        /patterns                     # All patterns
        /patterns --type=workflow     # Workflow patterns
        /patterns --visualize        # Include visualizations
    parameters:
      type:
        type: string
        required: false
        default: "all"
        values: [workflow, quality, communication, technical, all]
      timeframe:
        type: string
        required: false
        default: "30 days"
        description: "Analysis timeframe"
      visualize:
        type: boolean
        required: false
        default: false
        description: "Include pattern visualizations"
    metrics:
      track: [pattern_identification, pattern_types, user_adoption]

  # Quality Commands
  udtm:
    category: quality
    description: "Execute Ultra-Deep Thinking Mode for critical decisions"
    permission: standard
    aliases: [ultra-deep, deep-think, udtm-analysis]
    usage: |
      /udtm [topic] [--perspectives] [--depth] [--evidence]
      Examples:
        /udtm "microservices vs monolith"
        /udtm --perspectives=5 --depth=maximum
    parameters:
      topic:
        type: string
        required: false
        description: "Topic for analysis (interactive if not provided)"
      perspectives:
        type: integer
        required: false
        default: 7
        min: 3
        max: 15
        description: "Number of perspectives to analyze"
      depth:
        type: string
        required: false
        default: "standard"
        values: [quick, standard, deep, maximum]
      evidence:
        type: boolean
        required: false
        default: true
        description: "Require evidence for all claims"
    validation:
      - type: resource_available
        message: "UDTM analysis requires significant resources"
    metrics:
      track: [analysis_count, decision_quality, perspective_diversity]
    implementation: "ultra-deep-thinking-mode.md"

  quality-gate:
    category: quality
    description: "Execute quality gate validation at project milestones"
    permission: standard
    aliases: [qg, gate, checkpoint, validate]
    usage: |
      /quality-gate {phase} [--strict] [--report] [--fix]
      Examples:
        /quality-gate pre-implementation
        /quality-gate completion --report --fix
    parameters:
      phase:
        type: string
        required: true
        values: [pre-implementation, 25%, 50%, 75%, completion, custom]
        description: "Quality gate phase"
      strict:
        type: boolean
        required: false
        default: true
        description: "Enforce strict validation"
      report:
        type: boolean
        required: false
        default: true
        description: "Generate detailed report"
      fix:
        type: boolean
        required: false
        default: false
        description: "Attempt automatic fixes"
    validation:
      - type: phase_sequence
        message: "Cannot skip quality gate phases"
    metrics:
      track: [gate_passes, gate_failures, fix_success_rate]
    implementation: "quality_gate_validation.md"

  anti-pattern-check:
    category: quality
    description: "Scan for prohibited patterns and architectural violations"
    permission: standard
    aliases: [anti-pattern, pattern-check, scan-violations]
    usage: |
      /anti-pattern-check [--scope] [--severity] [--autofix]
      Examples:
        /anti-pattern-check                    # Full scan
        /anti-pattern-check --scope=current    # Current file only
        /anti-pattern-check --autofix         # Fix if possible
    parameters:
      scope:
        type: string
        required: false
        default: "all"
        values: [current, changed, all, custom]
        description: "Scan scope"
      severity:
        type: string
        required: false
        default: "all"
        values: [critical, high, medium, low, all]
        description: "Minimum severity to report"
      autofix:
        type: boolean
        required: false
        default: false
        description: "Attempt automatic fixes"
    validation:
      - type: scope_accessible
        message: "Cannot access specified scope"
    metrics:
      track: [patterns_found, severity_distribution, fix_rate]
    implementation: "anti_pattern_detection.md"

  brotherhood-review:
    category: quality
    description: "Initiate honest peer review process"
    permission: standard
    aliases: [peer-review, brotherhood, review]
    usage: |
      /brotherhood-review [--reviewers] [--focus] [--anonymous]
      Examples:
        /brotherhood-review                    # Standard review
        /brotherhood-review --reviewers=3      # Request 3 reviewers
        /brotherhood-review --focus=security   # Security-focused
    parameters:
      reviewers:
        type: integer
        required: false
        default: 2
        min: 1
        max: 5
        description: "Number of reviewers"
      focus:
        type: string
        required: false
        description: "Review focus area"
        values: [general, security, performance, architecture, quality]
      anonymous:
        type: boolean
        required: false
        default: false
        description: "Anonymous feedback"
    metrics:
      track: [review_count, feedback_quality, improvement_rate]
    implementation: "brotherhood_review.md"

  # Workflow Commands
  suggest:
    category: workflow
    description: "Get AI-powered next step recommendations"
    permission: standard
    aliases: [next, recommend, what-next, advice]
    usage: |
      /suggest [--context] [--confidence] [--alternatives]
      Examples:
        /suggest                      # Basic suggestion
        /suggest --alternatives=3     # Show 3 alternatives
        /suggest --confidence=high    # Only high-confidence suggestions
    parameters:
      context:
        type: string
        required: false
        description: "Additional context for suggestions"
      confidence:
        type: string
        required: false
        default: "medium"
        values: [low, medium, high, any]
        description: "Minimum confidence level"
      alternatives:
        type: integer
        required: false
        default: 1
        min: 1
        max: 5
        description: "Number of alternatives"
    metrics:
      track: [suggestion_acceptance, confidence_accuracy, user_satisfaction]

  handoff:
    category: workflow
    description: "Structured handoff between personas with context preservation"
    permission: standard
    aliases: [transfer, switch-to, pass-to]
    usage: |
      /handoff {persona} [--summary] [--checklist] [--validate]
      Examples:
        /handoff architect              # Handoff to architect
        /handoff pm --summary          # Include work summary
        /handoff dev --checklist       # Run handoff checklist
    parameters:
      persona:
        type: string
        required: true
        description: "Target persona"
        values: [analyst, pm, architect, dev, sm, po, quality, design-architect]
      summary:
        type: boolean
        required: false
        default: true
        description: "Include work summary"
      checklist:
        type: boolean
        required: false
        default: true
        description: "Run handoff checklist"
      validate:
        type: boolean
        required: false
        default: true
        description: "Validate handoff completeness"
    validation:
      - type: persona_exists
        message: "Unknown persona for handoff"
      - type: handoff_ready
        message: "Current work not ready for handoff"
    metrics:
      track: [handoff_success, context_preservation, handoff_time]
    implementation: "handoff-orchestration-task.md"

  core-dump:
    category: workflow
    description: "Save comprehensive session state with memory integration"
    permission: standard
    aliases: [save-state, checkpoint, dump]
    usage: |
      /core-dump [--format] [--include-memory] [--compress]
      Examples:
        /core-dump                     # Standard dump
        /core-dump --format=detailed   # Detailed format
        /core-dump --compress         # Compressed output
    parameters:
      format:
        type: string
        required: false
        default: "standard"
        values: [minimal, standard, detailed, full]
        description: "Dump format"
      include_memory:
        type: boolean
        required: false
        default: true
        description: "Include memory insights"
      compress:
        type: boolean
        required: false
        default: false
        description: "Compress output"
    metrics:
      track: [dump_frequency, dump_size, restore_success]
    implementation: "core-dump.md"

  # Consultation Commands
  consult:
    category: consultation
    description: "Start multi-persona consultation session"
    permission: standard
    aliases: [panel, team-consult, multi-persona]
    usage: |
      /consult {type} [--personas] [--duration] [--structured]
      Examples:
        /consult design-review              # Design review panel
        /consult custom --personas=pm,dev   # Custom consultation
        /consult emergency-response         # Emergency panel
    parameters:
      type:
        type: string
        required: true
        values: [design-review, technical-feasibility, product-strategy, quality-assessment, emergency-response, custom]
        description: "Consultation type"
      personas:
        type: array
        required: false
        description: "Custom persona list (for custom type)"
      duration:
        type: string
        required: false
        default: "standard"
        values: [quick, standard, thorough]
        description: "Consultation duration"
      structured:
        type: boolean
        required: false
        default: true
        description: "Use structured format"
    validation:
      - type: persona_combination
        message: "Invalid persona combination for consultation"
    metrics:
      track: [consultation_count, outcome_quality, consensus_rate]
    implementation: "multi-persona-protocols.md"

  panel-status:
    category: consultation
    description: "Show active consultation panel status"
    permission: standard
    aliases: [consultation-status, panel-info]
    usage: |
      /panel-status [--detailed] [--timeline]
      Examples:
        /panel-status              # Basic status
        /panel-status --detailed   # Detailed participant info
    parameters:
      detailed:
        type: boolean
        required: false
        default: false
        description: "Show detailed status"
      timeline:
        type: boolean
        required: false
        default: false
        description: "Show consultation timeline"
    metrics:
      track: [status_checks, active_panels]

  consensus-check:
    category: consultation
    description: "Assess agreement level in consultation"
    permission: standard
    aliases: [agreement, consensus, alignment]
    usage: |
      /consensus-check [--threshold] [--require-all]
      Examples:
        /consensus-check                  # Check consensus
        /consensus-check --threshold=80   # 80% agreement required
    parameters:
      threshold:
        type: integer
        required: false
        default: 70
        min: 50
        max: 100
        description: "Consensus threshold percentage"
      require_all:
        type: boolean
        required: false
        default: false
        description: "Require unanimous agreement"
    metrics:
      track: [consensus_rates, decision_quality]

  # System Commands
  diagnose:
    category: system
    description: "Comprehensive system health diagnostics"
    permission: admin
    aliases: [health, check-system, diagnostic]
    usage: |
      /diagnose [--component] [--deep] [--fix]
      Examples:
        /diagnose                    # Full system check
        /diagnose --component=memory # Check memory system
        /diagnose --deep --fix      # Deep scan with fixes
    parameters:
      component:
        type: string
        required: false
        default: "all"
        values: [all, memory, personas, tasks, quality, performance]
        description: "Component to diagnose"
      deep:
        type: boolean
        required: false
        default: false
        description: "Perform deep diagnostics"
      fix:
        type: boolean
        required: false
        default: false
        description: "Attempt automatic fixes"
    validation:
      - type: permission_check
        message: "Admin permission required for diagnostics"
    metrics:
      track: [diagnostic_runs, issues_found, fixes_applied]
    implementation: "system-diagnostics-task.md"

  optimize:
    category: system
    description: "Performance optimization with memory-based improvements"
    permission: admin
    aliases: [perf, performance, tune]
    usage: |
      /optimize [--target] [--aggressive] [--simulate]
      Examples:
        /optimize                      # Standard optimization
        /optimize --target=memory      # Optimize memory usage
        /optimize --aggressive         # Aggressive optimization
    parameters:
      target:
        type: string
        required: false
        default: "balanced"
        values: [speed, memory, balanced, quality]
        description: "Optimization target"
      aggressive:
        type: boolean
        required: false
        default: false
        description: "Use aggressive optimization"
      simulate:
        type: boolean
        required: false
        default: false
        description: "Simulate without applying"
    metrics:
      track: [optimization_runs, performance_gains, resource_savings]

  learn:
    category: system
    description: "Analyze outcomes and update system intelligence"
    permission: admin
    aliases: [ml-update, train, improve]
    usage: |
      /learn [--scope] [--feedback] [--apply]
      Examples:
        /learn                      # Learn from recent session
        /learn --scope=project      # Learn from entire project
        /learn --feedback          # Include user feedback
    parameters:
      scope:
        type: string
        required: false
        default: "session"
        values: [session, project, all]
        description: "Learning scope"
      feedback:
        type: boolean
        required: false
        default: true
        description: "Include user feedback"
      apply:
        type: boolean
        required: false
        default: true
        description: "Apply learnings immediately"
    metrics:
      track: [learning_sessions, pattern_updates, accuracy_improvements]

  # Enterprise Commands
  compliance-check:
    category: enterprise
    description: "Run compliance validation against standards"
    permission: enterprise
    aliases: [compliance, audit-compliance, standards-check]
    usage: |
      /compliance-check {standard} [--scope] [--report] [--remediate]
      Examples:
        /compliance-check SOC2              # SOC2 compliance
        /compliance-check GDPR --report     # GDPR with report
        /compliance-check ISO27001 --fix    # ISO with fixes
    parameters:
      standard:
        type: string
        required: true
        values: [SOC2, GDPR, HIPAA, ISO27001, PCI-DSS, NIST, custom]
        description: "Compliance standard"
      scope:
        type: string
        required: false
        default: "all"
        values: [code, data, infrastructure, processes, all]
        description: "Compliance scope"
      report:
        type: boolean
        required: false
        default: true
        description: "Generate compliance report"
      remediate:
        type: boolean
        required: false
        default: false
        description: "Suggest remediation steps"
    validation:
      - type: license_check
        message: "Enterprise license required for compliance features"
    metrics:
      track: [compliance_score, violations_found, remediation_success]

  audit-trail:
    category: enterprise
    description: "Generate comprehensive audit trail"
    permission: enterprise
    aliases: [audit, trail, audit-log]
    usage: |
      /audit-trail [--period] [--filter] [--export]
      Examples:
        /audit-trail --period="last month"
        /audit-trail --filter=security --export=pdf
    parameters:
      period:
        type: string
        required: false
        default: "last 30 days"
        description: "Audit period"
      filter:
        type: string
        required: false
        values: [all, security, quality, access, changes]
        description: "Filter audit events"
      export:
        type: string
        required: false
        values: [json, pdf, csv]
        description: "Export format"
    metrics:
      track: [audit_requests, event_coverage, export_formats]

  governance:
    category: enterprise
    description: "Governance policy enforcement and reporting"
    permission: enterprise
    aliases: [govern, policy, governance-check]
    usage: |
      /governance {action} [--policy] [--enforce]
      Examples:
        /governance check              # Check all policies
        /governance report --policy=security
        /governance enforce --policy=quality
    parameters:
      action:
        type: string
        required: true
        values: [check, report, enforce, update]
        description: "Governance action"
      policy:
        type: string
        required: false
        default: "all"
        values: [security, quality, access, data, all]
        description: "Policy category"
      enforce:
        type: boolean
        required: false
        default: false
        description: "Enforce policies strictly"
    metrics:
      track: [policy_violations, enforcement_actions, compliance_rate]

  # Advanced Commands
  predict:
    category: advanced
    description: "AI-powered predictions for project outcomes"
    permission: advanced
    aliases: [forecast, predict-outcome, ai-predict]
    usage: |
      /predict {target} [--confidence] [--scenarios]
      Examples:
        /predict delivery-date         # Predict delivery
        /predict quality-score         # Predict quality
        /predict risks --scenarios=3   # Risk scenarios
    parameters:
      target:
        type: string
        required: true
        values: [delivery-date, quality-score, risks, team-velocity, technical-debt]
        description: "Prediction target"
      confidence:
        type: boolean
        required: false
        default: true
        description: "Include confidence intervals"
      scenarios:
        type: integer
        required: false
        default: 1
        min: 1
        max: 5
        description: "Number of scenarios"
    metrics:
      track: [prediction_accuracy, confidence_calibration, user_trust]

  auto-complete:
    category: advanced
    description: "AI auto-completion for current task"
    permission: advanced
    aliases: [auto, complete, ai-complete]
    usage: |
      /auto-complete [--review] [--quality-check]
      Examples:
        /auto-complete               # Complete current task
        /auto-complete --review      # With human review
    parameters:
      review:
        type: boolean
        required: false
        default: true
        description: "Require human review"
      quality_check:
        type: boolean
        required: false
        default: true
        description: "Run quality checks"
    validation:
      - type: task_completable
        message: "No active task to complete"
    metrics:
      track: [completion_rate, quality_score, time_saved]

  deep-analysis:
    category: advanced
    description: "Deep AI analysis of codebase patterns"
    permission: advanced
    aliases: [deep-analyze, ai-analysis, analyze-deep]
    usage: |
      /deep-analysis {focus} [--depth] [--recommendations]
      Examples:
        /deep-analysis architecture    # Architecture analysis
        /deep-analysis performance     # Performance analysis
    parameters:
      focus:
        type: string
        required: true
        values: [architecture, performance, security, maintainability, all]
        description: "Analysis focus"
      depth:
        type: string
        required: false
        default: "standard"
        values: [surface, standard, deep, exhaustive]
        description: "Analysis depth"
      recommendations:
        type: boolean
        required: false
        default: true
        description: "Include recommendations"
    metrics:
      track: [analysis_depth, insights_generated, recommendation_adoption]

  # Utility Commands
  yolo:
    category: system
    description: "Toggle YOLO mode for streamlined execution"
    permission: standard
    aliases: [fast-mode, quick, bypass]
    usage: |
      /yolo [--confirm]
      Examples:
        /yolo              # Toggle YOLO mode
        /yolo --confirm    # Confirm state change
    parameters:
      confirm:
        type: boolean
        required: false
        default: false
        description: "Confirm mode change"
    metrics:
      track: [mode_toggles, yolo_usage, quality_impact]

  exit:
    category: core
    description: "Exit current persona or consultation"
    permission: basic
    aliases: [quit, leave, close]
    usage: |
      /exit [--save] [--handoff]
      Examples:
        /exit              # Exit current mode
        /exit --save       # Save state before exit
        /exit --handoff    # Suggest handoff target
    parameters:
      save:
        type: boolean
        required: false
        default: true
        description: "Save current state"
      handoff:
        type: boolean
        required: false
        default: false
        description: "Suggest handoff target"
    metrics:
      track: [exit_points, session_duration, completion_status]

  tasks:
    category: core
    description: "List available tasks with intelligence insights"
    permission: basic
    aliases: [list-tasks, available-tasks, what-can-i-do]
    usage: |
      /tasks [--category] [--recommended] [--details]
      Examples:
        /tasks                      # All tasks
        /tasks --category=quality   # Quality tasks
        /tasks --recommended       # AI recommendations
    parameters:
      category:
        type: string
        required: false
        values: [all, quality, workflow, analysis, documentation]
        description: "Task category filter"
      recommended:
        type: boolean
        required: false
        default: false
        description: "Show recommended tasks"
      details:
        type: boolean
        required: false
        default: false
        description: "Show task details"
    metrics:
      track: [task_discovery, task_selection, completion_rate]

  run-task:
    category: workflow
    description: "Execute a specific task"
    permission: standard
    aliases: [task, execute, do]
    usage: |
      /run-task {task-name} [...args]
      Examples:
        /run-task create-prd
        /run-task udtm-analysis "payment system"
        /run-task quality-gate pre-implementation
    parameters:
      task_name:
        type: string
        required: true
        description: "Task to execute"
      args:
        type: array
        required: false
        description: "Task-specific arguments"
    validation:
      - type: task_exists
        message: "Unknown task"
      - type: task_available
        message: "Task not available in current context"
    metrics:
      track: [task_execution, success_rate, execution_time]

  checklist:
    category: workflow
    description: "Run validation checklist"
    permission: standard
    aliases: [check, validate, run-checklist]
    usage: |
      /checklist {name} [--interactive] [--fix]
      Examples:
        /checklist po-master
        /checklist story-dod --interactive
        /checklist quality --fix
    parameters:
      name:
        type: string
        required: true
        description: "Checklist name"
        values: [po-master, story-dod, architect, quality, frontend, pm, change]
      interactive:
        type: boolean
        required: false
        default: false
        description: "Interactive mode"
      fix:
        type: boolean
        required: false
        default: false
        description: "Attempt fixes"
    metrics:
      track: [checklist_runs, pass_rate, fix_success]
    implementation: "checklist-run-task.md"

  # Meta-Prompting Commands
  meta-prompt:
    category: advanced
    description: "Generate and manage optimal prompts for sub-agents and tasks"
    permission: advanced
    aliases: [meta, prompt-gen, generate-prompt]
    usage: |
      /meta-prompt {action} [--options]
      Actions: generate, test, patterns, optimize, effectiveness, library
      Examples:
        /meta-prompt generate task --context "code review"
        /meta-prompt test prompt-123 --metrics
        /meta-prompt patterns --type task-execution
    parameters:
      action:
        type: string
        required: true
        values: [generate, test, patterns, optimize, effectiveness, library, persona, consultation, handoff, a-b, learn, cascade]
        description: "Meta-prompting action"
      type:
        type: string
        required: false
        values: [task, persona, consultation, analysis, custom]
        description: "Prompt type to generate"
      context:
        type: string
        required: false
        description: "Additional context for customization"
      optimize:
        type: string
        required: false
        values: [clarity, tokens, effectiveness, all]
        description: "Optimization focus"
      preview:
        type: boolean
        required: false
        default: true
        description: "Show prompt before deployment"
      metrics:
        type: boolean
        required: false
        default: false
        description: "Show detailed effectiveness metrics"
    validation:
      - type: advanced_permission
        message: "Advanced permission required for meta-prompting"
      - type: prompt_valid
        message: "Invalid prompt configuration"
    metrics:
      track: [prompt_generation, effectiveness_scores, optimization_gains, usage_patterns]
    implementation: "meta-prompt-generation-task.md"

  # Special Commands
  bootstrap-memory:
    category: memory
    description: "Bootstrap memory from existing codebase (brownfield)"
    permission: standard
    aliases: [bootstrap, mem-bootstrap, init-memory]
    usage: |
      /bootstrap-memory [--mode] [--focus] [--depth]
      Examples:
        /bootstrap-memory --mode=auto
        /bootstrap-memory --focus=architecture --depth=deep
        /bootstrap-memory --mode=interactive
    parameters:
      mode:
        type: string
        required: false
        default: "auto"
        values: [auto, interactive, guided]
        description: "Bootstrap mode"
      focus:
        type: string
        required: false
        values: [architecture, decisions, patterns, issues, all]
        description: "Focus area"
      depth:
        type: string
        required: false
        default: "standard"
        values: [shallow, standard, deep]
        description: "Analysis depth"
    validation:
      - type: codebase_exists
        message: "No codebase found to analyze"
    metrics:
      track: [bootstrap_runs, memories_created, pattern_extraction]
    implementation: "memory-bootstrap-task.md"

# Command Composition Rules
command_composition:
  allowed_chains:
    - pattern: "context -> suggest"
      description: "Get context then suggestions"
    - pattern: "quality-gate -> handoff"
      description: "Quality check before handoff"
    - pattern: "udtm -> core-dump"
      description: "Deep analysis then save"
    - pattern: "anti-pattern-check -> auto-complete"
      description: "Check patterns then complete"
  
  prohibited_chains:
    - pattern: "yolo -> quality-gate"
      reason: "Cannot run quality gates in YOLO mode"
    - pattern: "exit -> *"
      reason: "Exit must be final command"

# Command Shortcuts and Aliases
shortcuts:
  "?": "help"
  "??": "help --examples"
  "!!!": "emergency-response"
  ">>>": "suggest"
  "<<<": "recall"
  "+++": "quality-gate completion"
  "---": "exit --save"
  "@": "agents"
  "#": "context"
  "$": "tasks"
  "%": "metrics"

# Validation Rules
validation_rules:
  parameter_validation:
    - rule: "required_parameters"
      description: "All required parameters must be provided"
      enforcement: strict
    
    - rule: "parameter_types"
      description: "Parameters must match defined types"
      enforcement: strict
    
    - rule: "parameter_values"
      description: "Parameters must be within allowed values"
      enforcement: strict
  
  context_validation:
    - rule: "persona_availability"
      description: "Target persona must be available"
      enforcement: warning
    
    - rule: "permission_check"
      description: "User must have required permissions"
      enforcement: strict
    
    - rule: "resource_availability"
      description: "Required resources must be available"
      enforcement: warning

# Metrics and Tracking
metrics_configuration:
  tracking_enabled: true
  anonymous_metrics: false
  retention_days: 90
  
  tracked_metrics:
    - metric: "command_usage"
      description: "Track command usage patterns"
      aggregation: [count, frequency, user_patterns]
    
    - metric: "command_success"
      description: "Track command success rates"
      aggregation: [success_rate, error_types, recovery_rate]
    
    - metric: "performance_metrics"
      description: "Track command performance"
      aggregation: [execution_time, resource_usage, latency]
    
    - metric: "user_satisfaction"
      description: "Track user satisfaction metrics"
      aggregation: [command_ratings, preference_patterns, abandonment_rate]
  
  reporting:
    - report: "usage_analytics"
      frequency: daily
      metrics: [command_usage, popular_workflows, user_patterns]
    
    - report: "quality_metrics"
      frequency: weekly
      metrics: [quality_gate_passes, anti_pattern_frequency, compliance_scores]
    
    - report: "performance_report"
      frequency: daily
      metrics: [response_times, resource_usage, optimization_opportunities]

# Help Topics
help_topics:
  getting_started:
    title: "Getting Started with BMAD"
    content: |
      Welcome to BMAD Method IDE Orchestrator!
      
      Quick Start:
      1. Use /agents to see available personas
      2. Switch to a persona (e.g., /pm for Product Manager)
      3. Use /suggest for next step recommendations
      4. Use /help [topic] for detailed help
  
  memory_system:
    title: "Memory System Guide"
    content: |
      BMAD's memory system provides persistent learning:
      
      - /remember: Store important information
      - /recall: Search past memories
      - /insights: Get AI-powered insights
      - /patterns: See recognized patterns
      
      Memory categories: decisions, patterns, mistakes, preferences
  
  quality_framework:
    title: "Quality Framework"
    content: |
      BMAD enforces quality through:
      
      - Quality Gates: Checkpoints at 25%, 50%, 75%, 100%
      - UDTM: Ultra-Deep Thinking for critical decisions
      - Anti-Pattern Detection: Zero tolerance for bad patterns
      - Brotherhood Reviews: Honest peer feedback
  
  workflow_automation:
    title: "Workflow Automation"
    content: |
      Streamline your workflow with:
      
      - /suggest: AI-powered next steps
      - /handoff: Smooth persona transitions
      - /auto-complete: AI task completion
      - /consult: Multi-persona collaboration

# Version History
version_history:
  - version: "2.0.0"
    date: "2025-01-06"
    changes:
      - "Complete enterprise command registry"
      - "Added permission levels and validation"
      - "Implemented metrics and tracking"
      - "Added command composition rules"
      - "Enhanced help system"
  
  - version: "1.0.0"
    date: "2024-12-01"
    changes:
      - "Initial command registry"
      - "Basic persona commands"
      - "Core memory operations"